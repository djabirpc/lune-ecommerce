# PostgreSQL
POSTGRES_DB=luna
POSTGRES_USER=luna
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
APPLY_MIGRATIONS_ON_STARTUP=true

# JWT
JWT_ISSUER=Luna.Api
JWT_AUDIENCE=Luna.Client
JWT_KEY=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial SUPER_ADMIN account (seeded on first startup if both are set; leave blank to skip seeding)
INITIAL_ADMIN_EMAIL=admin@luna.local
INITIAL_ADMIN_PASSWORD=change-me-Now-123!
INITIAL_ADMIN_FIRST_NAME=Luna
INITIAL_ADMIN_LAST_NAME=Admin

# Shipping (CLAUDE.md sections 15-19). Leave blank — no real Yalidine/ZR Express API docs are
# available, so those adapters are structural-only and always reject with a clear error regardless
# of credentials. FakeShippingProvider is used for all development/testing shipments.
YALIDINE_BASE_URL=
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
ZR_EXPRESS_BASE_URL=
ZR_EXPRESS_API_KEY=
SHIPPING_SYNC_ENABLED=true
SHIPPING_SYNC_INTERVAL_SECONDS=300

# File storage (CLAUDE.md section 28). Local disk by default (served from /uploads, persisted via the
# uploads_data Docker volume). BACKEND_PUBLIC_URL must be the URL a browser can actually reach the
# backend at, since it's baked into every uploaded image's URL.
BACKEND_PUBLIC_URL=http://localhost:5000

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000

# Marketing (CLAUDE.md section 21). Leave blank to disable pixel loading entirely — no fake
# tracking is injected without a real Pixel ID configured.
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Storefront social links (homepage "Suivez-nous" section + footer). Leave blank to hide
# those links entirely rather than pointing to a placeholder URL.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
