# PostgreSQL
POSTGRES_DB=luna
POSTGRES_USER=luna
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
APPLY_MIGRATIONS_ON_STARTUP=true

# JWT
JWT_ISSUER=Luna.Api
JWT_AUDIENCE=Luna.Client
JWT_KEY=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000
