# Production build for Railway — NOT used by docker-compose (that still uses ./Dockerfile, the
# dev server with hot reload). Vite bakes VITE_* variables into the JS bundle at BUILD time, not
# read at container runtime, so they must be passed as Docker build args (Railway does this
# automatically from the service's Variables — see RAILWAY_DEPLOY.md).
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL
ARG VITE_META_PIXEL_ID
ARG VITE_TIKTOK_PIXEL_ID
ARG VITE_INSTAGRAM_URL
ARG VITE_TIKTOK_URL
ARG VITE_FACEBOOK_URL
ARG VITE_STORE_PHONE
ENV VITE_API_URL=$VITE_API_URL \
    VITE_META_PIXEL_ID=$VITE_META_PIXEL_ID \
    VITE_TIKTOK_PIXEL_ID=$VITE_TIKTOK_PIXEL_ID \
    VITE_INSTAGRAM_URL=$VITE_INSTAGRAM_URL \
    VITE_TIKTOK_URL=$VITE_TIKTOK_URL \
    VITE_FACEBOOK_URL=$VITE_FACEBOOK_URL \
    VITE_STORE_PHONE=$VITE_STORE_PHONE

RUN npm run build

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.railway.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
